# Copy to .env.local (gitignored). Every value is optional.

# Lead auth. When unset, leads use the Claude Code login already on this machine.
ANTHROPIC_API_KEY=

# Where Rooms keeps its database and runtime files.
# Default: ~/Library/Application Support/ConduitRooms
ROOMS_DATA_DIR=

# Where Conduit keeps state.json. Rooms reads it and never writes it.
# Default: ~/Library/Application Support/ConduitTauri
CONDUIT_DATA_DIR=

# The port the sidecar listens on. Default: 8530
ROOMS_SIDECAR_PORT=

# The gate decides which lead an untagged message is for.
# With this key it is Jev, TypeSafe's classifier (calls go to api.typesafe.ai).
TYPESAFE_API_KEY=

# Without the key, the gate is a local model served by Ollama.
# Defaults: qwen3:8b at http://127.0.0.1:11434
ROOMS_GATE_MODEL=
ROOMS_GATE_URL=
